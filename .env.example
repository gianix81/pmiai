# ---- Copia questo file in ".env" e compila i valori ----

# Porta del server
PORT=3000

# Provider AI: "mock" (nessuna chiave, per test) | "ollama" (locale gratis) | "gemini" (free tier) | "openai"
AI_PROVIDER=mock

# Ollama (locale, gratis) — installa da ollama.com, poi: ollama run llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Google Gemini (ha un free tier) — chiave da aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (a pagamento)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Instagram / Meta (Graph API — gratis, richiede App Review) ----
META_VERIFY_TOKEN=un_token_segreto_a_tua_scelta
META_PAGE_TOKEN=
IG_BUSINESS_ID=

# Se DRY_RUN=true, i DM/pubblicazioni vengono solo loggati (non inviati davvero)
DRY_RUN=true

# Guardrail compliance
MAX_DM_PER_HOUR=180
