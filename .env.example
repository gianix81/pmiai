# ---- Copia questo file in ".env" e compila i valori ----
PORT=3000

# ============ AI ============
# Provider: "mock" (nessuna chiave, per test) | "gemini" (free tier, consigliato) | "ollama" (locale gratis) | "openai"
AI_PROVIDER=mock

# Gemini — chiave gratis su https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama (tutto in locale, zero costi, serve il PC acceso)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI (a pagamento)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Robustezza AI
AI_TIMEOUT_MS=30000
AI_RETRIES=2
AI_RETRY_BASE_MS=800
AI_TEMPERATURE=0.7
# se il provider vero fallisce, ricadi sul mock invece di bloccare il sistema
AI_FALLBACK_MOCK=true
AI_VERBOSE=false

# ============ RAG (memoria documentale) ============
# Provider embeddings: vuoto = segue AI_PROVIDER; "local" = hashing locale senza chiavi
EMBED_PROVIDER=
RAG_DIMS=768
RAG_CHUNK_CHARS=1100
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=4
RAG_MIN_SCORE=0.12

# ============ Instagram / Meta (Graph API — gratis, richiede App Review) ============
META_VERIFY_TOKEN=un_token_segreto_a_tua_scelta
META_APP_SECRET=
META_PAGE_TOKEN=
IG_BUSINESS_ID=

# ============ Telegram (approvazione dal telefono — gratis) ============
# 1) scrivi a @BotFather su Telegram, /newbot, copia il token
# 2) scrivi al tuo bot un messaggio qualsiasi, poi metti il tuo chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# ============ Cold email (SMTP — es. il tuo dominio via Google/Brevo) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sirio <noreply@tuodominio.com>
# limite invii al giorno (deliverability): tienilo basso!
EMAIL_DAILY_LIMIT=25

# ============ Google — Sole: Gmail + Calendar in SOLA LETTURA ============
# Ottieni il refresh token con:  npm run google:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GMAIL_QUERY=is:unread newer_than:2d -category:promotions -category:social
GMAIL_MAX=15

# ============ Sicurezza dashboard ============
DASHBOARD_USER=admin
DASHBOARD_PASS=cambiami

# Se DRY_RUN=true, DM/pubblicazioni/email vengono solo loggati (non inviati)
DRY_RUN=true
MAX_DM_PER_HOUR=180
# ora del morning brief di Sole (0-23)
BRIEF_HOUR=7
