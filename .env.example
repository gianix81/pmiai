# ---- Copia questo file in ".env" e compila i valori ----
PORT=3000

# Provider AI: "mock" (nessuna chiave, per test) | "ollama" (locale gratis) | "gemini" (free tier) | "openai"
AI_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Instagram / Meta (Graph API — gratis, richiede App Review) ----
META_VERIFY_TOKEN=un_token_segreto_a_tua_scelta
META_APP_SECRET=
META_PAGE_TOKEN=
IG_BUSINESS_ID=

# ---- Telegram (approvazione dal telefono — gratis) ----
# 1) scrivi a @BotFather su Telegram, /newbot, copia il token
# 2) scrivi al tuo bot un messaggio qualsiasi, poi metti il tuo chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Cold email (SMTP — es. il tuo dominio via Google/Brevo) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sirio <noreply@tuodominio.com>
# limite invii al giorno (deliverability): tienilo basso!
EMAIL_DAILY_LIMIT=25

# ---- Sicurezza dashboard ----
DASHBOARD_USER=admin
DASHBOARD_PASS=cambiami

# Se DRY_RUN=true, DM/pubblicazioni/email vengono solo loggati (non inviati)
DRY_RUN=true
MAX_DM_PER_HOUR=180
